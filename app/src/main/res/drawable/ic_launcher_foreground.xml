<?xml version="1.0" encoding="utf-8"?>
<!-- An address cut into the parts that decide who answers it: a pill split into
     three labels, the rightmost two — the owner-part — weighted and bracketed,
     with the wording it arrived in as two quiet lines above. The bracket is the
     whole app: read right to left, not left to right. Vector paths only, one
     colour, so the adaptive monochrome layer can reuse the same drawable. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- two lines of message wording -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeAlpha="0.5"
        android:pathData="M30,31 L62,31" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeAlpha="0.5"
        android:pathData="M30,38 L52,38" />

    <!-- the address, as one pill -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="3.1"
        android:pathData="M38,46 L70,46 Q82,46 82,58 Q82,70 70,70 L38,70 Q26,70 26,58 Q26,46 38,46 Z" />

    <!-- where one label ends and the next begins -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.45"
        android:pathData="M44,48 L44,68" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.45"
        android:pathData="M58,48 L58,68" />

    <!-- the owner-part, weighted -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="4.4"
        android:strokeLineCap="round"
        android:pathData="M62,58 L74,58" />

    <!-- the bracket that says: this is the part that answers -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4FE0E4"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.85"
        android:pathData="M56,76 L56,81 L80,81 L80,76" />
</vector>
