<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage, contacts, accounts, camera, phone or network-state permission,
         and no SMS permission — deliberately. Reading a person's inbox to warn them
         would make this the thing it guards against, so the message comes to the app
         by share sheet or by hand, one payload at a time, and nothing else on the
         device is looked at.

         INTERNET exists solely for the optional plain-words pass. With no key entered
         the app makes no request at all, and it never follows a link it is shown. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Guard">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Guard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share the message in from wherever it landed. ACTION_VIEW with an
                 http(s) scheme is NOT claimed: being asked to open a link is the
                 moment to check it, not a reason to visit it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
